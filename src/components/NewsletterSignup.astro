<section class="newsletter-section" aria-labelledby="newsletter-heading">
  <h2 id="newsletter-heading">Newsletter</h2>
  <p class="newsletter-intro">Recibe novedades y recursos de <span class="logo-colored">MEDI lens</span> directamente en tu correo.</p>
  <form class="newsletter-form" id="newsletter-form" action="/api/newsletter" method="post">
    <label class="newsletter-email-field" for="newsletter-email">
      <span>Correo electrónico</span>
      <input id="newsletter-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="tu@correo.com" required />
    </label>
    <p class="newsletter-consent">Al pulsar «Suscribirme al boletín», solicito recibirlo en este correo electrónico. Puedo darme de baja en cualquier momento. Consulta nuestra <a href="/politica-privacidad">Política de privacidad</a>.</p>
    <div class="newsletter-honeypot" aria-hidden="true">
      <label for="newsletter-company">No rellenes este campo</label>
      <input id="newsletter-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <p class="newsletter-status" id="newsletter-status" role="status" aria-live="polite" hidden>
      <i class="newsletter-status-icon ph ph-spinner-gap" aria-hidden="true"></i>
      <span class="newsletter-status-text"></span>
    </p>
    <button type="submit">Suscribirme al boletín</button>
  </form>
</section>

<script>
  const newsletterForm = document.querySelector<HTMLFormElement>('#newsletter-form');

  newsletterForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!newsletterForm.reportValidity()) return;

    const submitButton = newsletterForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = newsletterForm.querySelector<HTMLParagraphElement>('#newsletter-status');
    const statusText = status?.querySelector<HTMLSpanElement>('.newsletter-status-text');
    const statusIcon = status?.querySelector<HTMLElement>('.newsletter-status-icon');
    if (!submitButton || !status || !statusText || !statusIcon) return;

    submitButton.disabled = true;
    status.hidden = false;
    status.dataset.state = 'loading';
    statusText.textContent = 'Enviando tu solicitud…';
    statusIcon.className = 'newsletter-status-icon ph ph-spinner-gap';

    try {
      const response = await fetch(newsletterForm.action, {
        method: 'POST',
        body: new FormData(newsletterForm),
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      });
      const result = await response.json();
      if (!response.ok) throw new Error('newsletter_request_failed');

      status.dataset.state = 'success';
      statusText.textContent = result.message;
      statusIcon.className = 'newsletter-status-icon ph ph-check-circle';
      newsletterForm.reset();
    } catch {
      status.dataset.state = 'error';
      statusText.textContent = 'No se pudo completar la suscripción. Inténtalo de nuevo más tarde.';
      statusIcon.className = 'newsletter-status-icon ph ph-warning-circle';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
