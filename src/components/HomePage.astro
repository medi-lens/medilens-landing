---
import { Image } from 'astro:assets';
import SiteLayout from '@/layouts/SiteLayout.astro';
import StoreBadges from './StoreBadges.astro';
import Features from './Features.astro';
import FrequentlyAskedQuestions from './FrequentlyAskedQuestions.astro';
import Sponsorship from './Sponsorship.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import PressNews from './PressNews.astro';
import screenshot from '@/assets/images/medilens-screenshot.png';

---
<SiteLayout
  title="MEDI lens — Escanea y conoce tus medicamentos"
  seoTitle="MEDI lens — Escanea y conoce tus medicamentos"
  description="MEDI lens te permite escanear medicamentos, ver prospectos, composición, receta y gestionar un botiquín digital con alertas de caducidad."
>
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <div class="hero-title-group">
          <p class="hero-brand"><span class="hero-brand-primary">MEDI</span> <span class="hero-brand-accent">lens</span></p>
          <h1>Escanea y conoce tus medicamentos al instante</h1>
        </div>
        <p class="hero-tagline">Escanea y consulta tus medicamentos. Guárdalos en un botiquín digital, recibe alertas antes de que caduquen y accede siempre a la información oficial de la AEMPS.</p>
        <StoreBadges showCompatibility />
        <div class="hero-notes" aria-label="Características de MEDI lens">
          <span class="hero-note"><i class="ph ph-shield-check" aria-hidden="true"></i> Información oficial de la AEMPS</span>
          <span class="hero-note"><i class="ph ph-device-mobile" aria-hidden="true"></i> Gratis · Para Android y iPhone</span>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-image-glow" aria-hidden="true"></div>
        <Image class="hero-image" src={screenshot} alt="Pantalla de MEDI lens con el buscador, las búsquedas recientes y el acceso al botiquín" width={420} quality={88} format="webp" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <Features />

    <section class="custom-home-content">
      <FrequentlyAskedQuestions />

      <Sponsorship />

      <PressNews />

      <NewsletterSignup />
    </section>
  </main>
</SiteLayout>
